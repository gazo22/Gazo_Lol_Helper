{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "RiftLens": "Server=localhost,1433;Database=RiftLens;User Id=sa;Encrypt=False;TrustServerCertificate=True"
  },
  "Riot": {
    "DefaultPlatform": "Euw1",
    "RateLimit": {
      "BudgetShare": 1.0,
      "DefaultPriority": "Interactive"
    }
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "AllowedHosts": "*",
  "Stats": {
    "MinGames": 150,
    "MinBuildGames": 30,
    "MinMatchupGames": 20
  }
}