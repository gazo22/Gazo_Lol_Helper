<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <!-- WebView2CompositionControl (utilisé par BlazorWebView) requiert la projection Windows SDK. -->
    <UseWPF>true</UseWPF>
    <RootNamespace>RiftLens.Desktop</RootNamespace>
    <UserSecretsId>riftlens-desktop-c91e3a</UserSecretsId>
    <ApplicationIcon>..\..\assets\riftlens.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RiftLens.UI\RiftLens.UI.csproj" />
    <ProjectReference Include="..\RiftLens.LocalClient\RiftLens.LocalClient.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="..\..\assets\riftlens.ico" Link="riftlens.ico" />
  </ItemGroup>
</Project>
