<Window x:Class="RiftLens.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:ui="clr-namespace:RiftLens.UI;assembly=RiftLens.UI"
        Title="RiftLens" Width="1360" Height="860" MinWidth="1100" MinHeight="680"
        Background="#05080F" WindowStartupLocation="CenterScreen">
  <blazor:BlazorWebView x:Name="WebView" HostPage="wwwroot\index.html">
    <blazor:BlazorWebView.RootComponents>
      <blazor:RootComponent Selector="#app" ComponentType="{x:Type ui:AppRouter}" />
    </blazor:BlazorWebView.RootComponents>
  </blazor:BlazorWebView>
</Window>
