@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject CommandPaletteState Palette
@inject IJSRuntime JS
@inject IBackendStatus Backend
@inject NavigationManager Nav

<div class="rl-shell">
    <aside class="rl-sidebar">
        <a class="rl-brand" href="">
            <svg class="rl-brand__mark" viewBox="0 0 32 32" aria-hidden="true">
                <defs>
                    <linearGradient id="rl-mark" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0" stop-color="#67e8f9" /><stop offset="1" stop-color="#3b82f6" />
                    </linearGradient>
                </defs>
                <path d="M16 2 29 9.5v13L16 30 3 22.5v-13z" fill="none" stroke="url(#rl-mark)" stroke-width="2" />
                <circle cx="16" cy="16" r="5.5" fill="none" stroke="url(#rl-mark)" stroke-width="2" />
                <circle cx="16" cy="16" r="2" fill="#22d3ee" />
            </svg>
            <span class="rl-brand__name">Rift<span>Lens</span></span>
        </a>
        <NavMenu />
        <div class="rl-sidebar__footer">
            RiftLens n'est pas approuvé par Riot Games et ne reflète pas les opinions de Riot Games ou de toute personne
            officiellement impliquée dans la production ou la gestion de League of Legends.
        </div>
    </aside>

    <header class="rl-topbar">
        <button class="rl-search-trigger" type="button" @onclick="Palette.Open">
            <Icon Name="search" />
            <span class="rl-search-trigger__label">Rechercher un joueur ou un champion…</span>
            <span class="rl-kbd">Ctrl</span><span class="rl-kbd">K</span>
        </button>
        <div class="rl-topbar__right">
            <ConnectionStatus />
        </div>
    </header>

    <main class="rl-main">
        <ServerBanner />
        <AppErrorBoundary @ref="_boundary">@Body</AppErrorBoundary>
    </main>
</div>

<AppErrorBoundary><CommandPalette /></AppErrorBoundary>

@code {
    private IJSObjectReference? _module;
    private IJSObjectReference? _hotkeys;
    private DotNetObjectReference<MainLayout>? _self;
    private readonly CancellationTokenSource _monitor = new();
    private AppErrorBoundary? _boundary;

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    // Une nouvelle navigation efface l'erreur affichée par la page précédente.
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => _boundary?.Recover();
    private bool _setupOffered;

    /// <summary>Surveille le serveur toutes les 30 s (service arrêté, clé Riot expirée…).</summary>
    private async Task MonitorBackendAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        try
        {
            do
            {
                await Backend.RefreshAsync(_monitor.Token);
                OfferSetupOnce();
            }
            while (await timer.WaitForNextTickAsync(_monitor.Token));
        }
        catch (OperationCanceledException)
        {
            // Fenêtre fermée.
        }
    }

    /// <summary>Premier lancement : redirige vers l'assistant si la clé Riot du serveur local manque.</summary>
    private void OfferSetupOnce()
    {
        if (!_setupOffered && Backend.ServerInfo is { LocalMode: true, RiotKey: RiftLens.Contracts.RiotKeyStates.Missing })
        {
            _setupOffered = true;
            _ = InvokeAsync(() => Nav.NavigateTo("setup"));
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _ = MonitorBackendAsync();
        _self = DotNetObjectReference.Create(this);
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/RiftLens.UI/js/riftlens.js");
        _hotkeys = await _module.InvokeAsync<IJSObjectReference>("registerHotkeys", _self);
    }

    [JSInvokable]
    public void TogglePalette() => Palette.Toggle();

    public async ValueTask DisposeAsync()
    {
        Nav.LocationChanged -= OnLocationChanged;
        await _monitor.CancelAsync();
        _monitor.Dispose();
        try
        {
            if (_hotkeys is not null) { await _hotkeys.InvokeVoidAsync("dispose"); await _hotkeys.DisposeAsync(); }
            if (_module is not null) { await _module.DisposeAsync(); }
        }
        catch (JSDisconnectedException)
        {
            // WebView déjà fermée.
        }

        _self?.Dispose();
    }
}
