<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>RiftLens-Setup</OutputName>
    <OutputType>Bundle</OutputType>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
  </PropertyGroup>
  <ItemGroup>
    <!-- Programmes d'installation Microsoft téléchargés par la CI (voir .github/workflows/release.yml). -->
    <BindPath Include="$(MSBuildThisFileDirectory)redist" BindName="Redist" />
    <BindPath Include="$(MSBuildThisFileDirectory)..\..\assets" BindName="Assets" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Package\RiftLens.Package.wixproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Bal.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
