<Project>
  <!-- Isole l'installeur des réglages .NET de la solution (TFM, analyseurs, gestion centralisée des paquets). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <!-- Dossier des binaires publiés (dotnet publish -o artifacts/...) -->
    <ArtifactsRoot>$(MSBuildThisFileDirectory)..\artifacts\</ArtifactsRoot>
    <DefineConstants>Version=$(Version)</DefineConstants>
  </PropertyGroup>
</Project>
